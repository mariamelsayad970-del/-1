rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // الأدمن الوحيد: لازم يكون مسجل دخول بإيميله وباسورده (Firebase Auth)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'mariammohamedelsyad@gmail.com';
    }

    // القراءة للكل (تطبيق المستخدمين)، والكتابة للأدمن بس
    match /notifs/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /gallery/{id} { allow read: if true; allow write: if isAdmin(); }
    match /chal/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /games/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /cfg/{id}     { allow read: if true; allow write: if isAdmin(); }

    // أي مسار تاني ممنوع تمامًا
    match /{document=**} { allow read, write: if false; }
  }
}
